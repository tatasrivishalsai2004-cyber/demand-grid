generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"
  url = env("DATABASE_URL") }

enum Role { RETAILER SUPPLIER MANUFACTURER ADMIN }
enum POStatus { PENDING CONFIRMED SHIPPED DELIVERED CANCELLED }

// Store = tenant. Every retailer table carries storeId; ALWAYS filter by it.
model Store {
  id String @id @default(cuid())
  name String
  city String
  type String @default("PHARMACY")
  users User[]
  products Product[]
  sales Sale[]
  orders PurchaseOrder[]
  devices Device[]
  createdAt DateTime @default(now())
}
model User {
  id String @id @default(cuid())
  phone String @unique
  name String
  role Role
  storeId String?
  supplierId String?
  store Store? @relation(fields: [storeId], references: [id])
}
model Product {
  id String @id @default(cuid())
  storeId String
  sku String
  barcode String?
  name String
  category String?
  unitCost Decimal @db.Decimal(10,2)
  mrp Decimal @db.Decimal(10,2)
  gstPct Int @default(12)
  leadDays Int @default(2)
  safetyStock Int @default(0)
  supplierId String?
  store Store @relation(fields: [storeId], references: [id])
  batches Inventory[]
  items SaleItem[]
  forecasts Forecast[]
  @@unique([storeId, sku])
  @@index([storeId, barcode])
}
// One row per batch (expiry matters for pharmacies; sold FEFO).
model Inventory {
  id String @id @default(cuid())
  storeId String
  productId String
  batchNo String
  expiry DateTime
  qty Int
  product Product @relation(fields: [productId], references: [id])
  events InventoryEvent[]
  @@index([storeId, productId, expiry])
}
model InventoryEvent {
  id String @id @default(cuid())
  storeId String
  inventoryId String
  delta Int
  reason String // SALE | PURCHASE | DEVICE | ADJUST
  ref String?
  createdAt DateTime @default(now())
  inventory Inventory @relation(fields: [inventoryId], references: [id])
  @@index([storeId, createdAt])
}
model Sale {
  id String @id @default(cuid())
  storeId String
  receiptNo String
  customer String?
  subtotal Decimal @db.Decimal(12,2)
  gst Decimal @db.Decimal(12,2)
  total Decimal @db.Decimal(12,2)
  createdAt DateTime @default(now())
  store Store @relation(fields: [storeId], references: [id])
  items SaleItem[]
  @@unique([storeId, receiptNo])
  @@index([storeId, createdAt])
}
model SaleItem {
  id String @id @default(cuid())
  saleId String
  productId String
  batchNo String
  qty Int
  price Decimal @db.Decimal(10,2)
  gstPct Int
  sale Sale @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}
model Supplier {
  id String @id @default(cuid())
  name String
  reliability Int @default(90)
  rating Float @default(4.5)
  products SupplierProduct[]
}
model SupplierProduct {
  id String @id @default(cuid())
  supplierId String
  sku String
  price Decimal @db.Decimal(10,2)
  availabilityPct Int @default(95)
  leadDays Int @default(2)
  supplier Supplier @relation(fields: [supplierId], references: [id])
  @@unique([supplierId, sku])
}
model PurchaseOrder {
  id String @id @default(cuid())
  storeId String
  supplierId String
  status POStatus @default(PENDING)
  total Decimal @db.Decimal(12,2)
  createdAt DateTime @default(now())
  store Store @relation(fields: [storeId], references: [id])
  items PurchaseOrderItem[]
  @@index([storeId, status])
}
model PurchaseOrderItem {
  id String @id @default(cuid())
  orderId String
  productId String
  qty Int
  price Decimal @db.Decimal(10,2)
  order PurchaseOrder @relation(fields: [orderId], references: [id])
}
model Forecast {
  id String @id @default(cuid())
  storeId String
  productId String
  dailyDemand Float
  confidence Float
  model String @default("wma-trend")
  createdAt DateTime @default(now())
  product Product @relation(fields: [productId], references: [id])
  @@index([storeId, productId, createdAt])
}
model ReorderRecommendation {
  id String @id @default(cuid())
  storeId String
  productId String
  qty Int
  daysLeft Float
  explanation Json
  createdAt DateTime @default(now())
  @@index([storeId, createdAt])
}
model Device {
  id String @id @default(cuid())
  storeId String
  name String
  certFingerprint String?
  firmware String?
  store Store @relation(fields: [storeId], references: [id])
  events DeviceEvent[]
}
model DeviceEvent {
  id String @id @default(cuid())
  deviceId String
  bin Int
  weightG Float
  createdAt DateTime @default(now())
  device Device @relation(fields: [deviceId], references: [id])
}
model Notification {
  id String @id @default(cuid())
  storeId String
  kind String
  message String
  read Boolean @default(false)
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(cuid())
  storeId String?
  userId String?
  action String
  meta Json?
  createdAt DateTime @default(now())
}
